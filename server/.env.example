# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed front-end origins (CORS)
CLIENT_URL=http://localhost:5173
# Public site URL (used in sitemap.xml)
SITE_URL=https://hyxc.ae

# ---- MongoDB ----
# Free: MongoDB Atlas M0 (see README, section 4)
# Local:  mongodb://127.0.0.1:27017/hyxc
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/hyxc?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used ONLY by `npm run seed` to create the admin account. Choose your own; min 10 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cloudinary (image uploads) ----
# Free plan at https://cloudinary.com/console (images + video)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
